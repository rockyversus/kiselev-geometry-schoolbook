\begin{tikzpicture}[line cap=round,line join=round,every node/.style={inner sep=3pt}]
    \coordinate (A) at (1.55,-0.7);
    \coordinate (B) at (-0.9,0.75);
    \path (A) -- (B) coordinate[midway] (C);
    \coordinate (O) at (0.325,3.5);
    \coordinate (O1) at (0.325,-3.45);
    \coordinate (M) at (-2.37,-1.2);
    \coordinate (N) at (3.118,-0.5);
    \path (M) -- (A) coordinate[pos=0.25] (D);

    \draw[thick] (-3.25,-1.55) -- (-1.95,1.6) -- (-0.9,1.6);
    \draw[thick,densely dashed] (-0.9,1.6) -- (1.55,1.6);
    \draw[very thick] (-3.25,-1.55) -- (2.75,-1.55) -- (4.05,1.6) -- (1.55,1.6);

    \draw[thick] (B) -- (-0.9,4.75) -- (1.55,3.3) -- (A)
        (-0.9,-1.55) -- (-0.9,-3.25) -- (1.55,-4.7) -- (1.55,-1.55);
    \draw[thick,densely dashed] (B) -- (-0.9,-1.55) (A) -- (1.55,-1.55);
    \draw[thick] (B) -- (A) (M) -- (N);
    \draw[thick,densely dashed] (O) -- (A) -- (O1) -- (D) -- (O) (D) -- (C);
    \draw[very thick] (O) -- (C);
    \draw[thick,densely dashed] (C) -- (O1);

    \foreach \point in {A,B,C,D,O,O1} {
        \filldraw[fill=white] (\point) circle[radius=1pt];
    }
    \node[right,xshift=2pt,yshift=-5pt] at (A) {\(A\)};
    \node[left] at (B) {\(B\)};
    \node[above right,yshift=2pt] at (C) {\(C\)};
    \node[above left] at (D) {\(D\)};
    \node[above] at (M) {\(M\)};
    \node[above left] at (N) {\(N\)};
    \node[right,inner sep=4pt] at (O) {\(O\)};
    \node[right,inner sep=4pt] at (O1) {\(O_1\)};
    \node at (3,1.16) {\(P\)};
    \node at (1.16,2.85) {\(Q\)};
\end{tikzpicture}

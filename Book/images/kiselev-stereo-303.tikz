\begin{tikzpicture}[scale=1.3,line cap=round,line join=round]
    \coordinate (A) at (1.6,2.8);
    \coordinate (B) at (1,5.5);
    \coordinate (B1) at (2.2222,0);
    \coordinate (C) at (3.67,5.5);
    \coordinate (C1) at (0.22,1);
    \coordinate (D) at (3.256,4.96);
    \coordinate (D1) at (2.08,0.64);
    \coordinate (E) at (2.668,2.8);

    % Плоскость Q. Часть левого ребра скрыта плоскостью P.
    \draw[thick] (0,2.63) -- (0,5.9) -- (4.1,5.9) -- (4.1,0) -- (0,0) -- (0,1.45);
    \draw[thick,densely dashed] (0,2.63) -- (0,1.45);

    % Плоскость P. Дальняя часть контура скрыта плоскостью Q.
    \draw[very thick] (0,2.63) -- (-0.45,1.45) -- (3.58,1.45) -- (4.63,4.2) -- (4.1,4.2);
    \draw[thick,densely dashed] (0,2.63) -- (0.6,4.2) -- (4.1,4.2);

    \draw[thick] (B) -- (A) (C) -- (A) (D) -- (E);
    \draw[thick,densely dashed] (A) -- (1.9,1.45) (A) -- (0.565,1.45) (E) -- (2.3,1.45);
    \draw[thick] (1.9,1.45) -- (B1) (0.565,1.45) -- (C1) (2.3,1.45) -- (D1);
    \draw[very thick] (0.62,2.8) -- (3.42,2.8);

    \node[above left,inner sep=3pt,xshift=-2pt] at (A) {\(A\)};
    \node[right,inner sep=3pt] at (B) {\(B\)};
    \node[below right,inner sep=3pt] at (B1) {\(B_1\)};
    \node[left,inner sep=4pt] at (C) {\(C\)};
    \node[below right,inner sep=3pt] at (C1) {\(C_1\)};
    \node[left,inner sep=4pt] at (D) {\(D\)};
    \node[left,inner sep=3pt] at (D1) {\(D_1\)};
    \node[above right,inner sep=3pt,xshift=2pt] at (E) {\(E\)};
    \node[above right,inner sep=3pt] at (0,1.45) {\(P\)};
    \node[below right,inner sep=4pt] at (0,5.9) {\(Q\)};
\end{tikzpicture}

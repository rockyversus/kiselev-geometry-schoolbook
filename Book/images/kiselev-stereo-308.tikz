\begin{tikzpicture}[line cap=round,line join=round,every node/.style={inner sep=3pt}]
    \coordinate (A) at (-1.3,0.72);
    \coordinate (B) at (1.4,-0.72);
    \path (A) -- (B) coordinate[midway] (O);
    \coordinate (C) at (0.05,2.5);
    \coordinate (M) at (-2.2,-1);
    \coordinate (N) at (2.075,0.9);
    \coordinate (Qedge) at (1.4,0.6);

    \draw[thick] (-3.2,-1.55) -- (-1.72,1.65) -- (-1.3,1.65);
    \draw[thick,densely dashed] (-1.3,1.65) -- (1.4,1.65);
    \draw[very thick] (-3.2,-1.55) -- (2.55,-1.55) -- (4.03,1.65) -- (1.4,1.65);

    \draw[thick] (A) -- (-1.3,3.22) -- (1.4,1.78) -- (B) -- cycle;
    \draw[very thick] (O) -- (C);
    \draw[thick] (M) -- (O) (Qedge) -- (N);
    \draw[thick,densely dashed] (O) -- (Qedge);

    \node[left] at (A) {\(A\)};
    \node[below right] at (B) {\(B\)};
    \node[above] at (C) {\(C\)};
    \node[below left] at (M) {\(M\)};
    \node[right] at (N) {\(N\)};
    \node[below] at (O) {\(O\)};
    \node at (2.97,1.15) {\(P\)};
    \node at (-0.96,2.67) {\(Q\)};
\end{tikzpicture}

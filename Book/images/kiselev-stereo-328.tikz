\begin{tikzpicture}[line cap=round,line join=round]
    \coordinate (A) at (-1.47,3.53);
    \coordinate (B) at (-1.47,1.15);
    \coordinate (B1) at (-1.47,-2.27);
    \coordinate (C) at (1.53,1.7);
    \coordinate (C1) at (1.53,-1.72);
    \coordinate (D) at (0.76,0.54);
    \coordinate (D1) at (0.76,-2.88);
    \foreach \height/\plane in {0.06/P,-3.36/Q}{
        \begin{scope}[yshift=\height cm]
            \draw[thick] (-3.34,0) -- (-2.47,2.2) -- (-1.47,2.2);
            \draw[thick,densely dashed] (-1.47,2.2) -- (1.53,2.2);
            \draw[thick] (1.53,2.2) -- (3.21,2.2);
            \draw[very thick] (-3.34,0) -- (2.34,0) -- (3.21,2.2);
            \node at (-2.84,0.45) {\(\plane\)};
        \end{scope}
    }
    \draw[thick] (A) -- (1.53,4.14) -- (C)
        (A) -- (0.76,3.05) -- (D) -- (B) -- (A);
    \draw[thick,densely dashed] (B) -- (C)
        (B) -- (-1.47,0.06) (C) -- (1.53,0.06) (D) -- (0.76,0.06)
        (B1) -- (C1);
    \draw[thick] (-1.47,0.06) -- (B1) -- (D1) -- (0.76,0.06)
        (1.53,0.06) -- (C1);
    \node[above left] at (A) {\(A\)};
    \node[left] at (B) {\(B\)};
    \node[below left] at (B1) {\(B_1\)};
    \node[right] at (C) {\(C\)};
    \node[right] at (C1) {\(C_1\)};
    \node[right,yshift=3pt] at (D) {\(D\)};
    \node[right] at (D1) {\(D_1\)};
    \node at (1.02,3.72) {\(M\)};
    \node at (0.23,2.84) {\(N\)};
\end{tikzpicture}

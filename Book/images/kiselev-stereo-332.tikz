            \draw[thick,densely dashed] (D) -- (\x,\bottom);
            \node[below left] at (\x,\top) {\(\face\)};
        }
        \draw[very thick] (C) -- (1.91,0.13) -- (1.91,-3.71) -- (D);
        \node[below left] at (1.91,0.13) {\(S\)};
        \node[above left] at (C) {\(C\)};
        \node[left] at (D) {\(D\)};
    \end{scope}
\end{tikzpicture}
